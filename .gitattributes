* text=auto

# Keep source and documentation files stable across Windows/WSL.
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Windows scripts are friendlier with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts should never be line-ending normalized.
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.whl binary
*.tar.gz binary
